# Earth Engine Cloud project with Earth Engine API enabled.
EE_PROJECT=

# Optional service-account authentication. Leave both blank to use Earth Engine
# Application Default Credentials (for example, `earthengine authenticate`).
EE_SERVICE_ACCOUNT=
EE_PRIVATE_KEY_PATH=
GOOGLE_APPLICATION_CREDENTIALS=

# Docker Compose service settings. The ports avoid conflicts with common local
# PostgreSQL and RabbitMQ installations.
POSTGRES_PASSWORD=agrideep
POSTGRES_PORT=5433
RABBITMQ_USERNAME=agrideep
RABBITMQ_PASSWORD=agrideep
RABBITMQ_PORT=5673
RABBITMQ_MANAGEMENT_PORT=15673
API_PORT=8000

# Satellite processing defaults (the API-contract values are proposals).
SATELLITE_MAX_CLOUD_PCT=20
SATELLITE_MIN_AREA_HA=0.1
SATELLITE_MAX_AREA_HA=500
SATELLITE_MAX_PERIOD_MONTHS=12
SATELLITE_EARLIEST_DATE=2017-03-28
SATELLITE_PROCESSING_SCALE_M=20
SATELLITE_REQUEST_TIMEOUT_SECONDS=120
SATELLITE_OUTPUT_DIR=data/output
